# systemd unit for the OncoTrace-AI analysis backend.
#
# Install (one-time):
#   sudo cp server/deploy/oncotrace-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oncotrace-backend
#
# EDIT THE PATHS AND USER BELOW to match the actual deploy account and clone
# location on this host before installing -- the values here are placeholders.
#
# After any future `git pull` that touches server/, restart with:
#   sudo systemctl restart oncotrace-backend
#
# Logs:
#   journalctl -u oncotrace-backend -f

[Unit]
Description=OncoTrace-AI analysis backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=anand
WorkingDirectory=/home/anand/OncoTrace-AI/server
Environment="ONCOTRACE_PANEL_NAME=Targeted Oncology Panel (GeneMind SURFSeq5000)"

# Sized for an AWS t3.large (2 vCPU / 8 GB RAM). Each analysis spawns
# `java -Xmx4g`, so worker_count x ONCOTRACE_MAX_CONCURRENT_ANALYSES x 4GB is a
# hard memory budget, not a soft one -- exceeding host RAM means the OOM killer
# picks a process at random, which is a far worse failure mode than a 503.
# With --workers 2 below, ONCOTRACE_MAX_CONCURRENT_ANALYSES must stay at 1
# (config.py's default) to cap peak usage at 2 x 1 x 4GB = 8GB, leaving nothing
# to spare for nginx/OS/React static files -- do not raise either value on this
# instance size without also increasing RAM.
Environment="ONCOTRACE_MAX_CONCURRENT_ANALYSES=1"

# Secrets live here, NOT in this file. The unit file is world-readable and
# `systemctl show` would print any Environment= value to any local user, so the
# demo credential is loaded from a root-owned 0600 file instead:
#
#   sudo install -m 600 -o root -g root /dev/null /etc/oncotrace/env
#   sudo mkdir -p /etc/oncotrace
#   sudo nano /etc/oncotrace/env      # see server/.env.example for the keys
#   sudo systemctl restart oncotrace-backend
#
# Leading '-' means "start anyway if the file is missing" -- the app then
# fail-closes with a clear 503 rather than refusing to boot, so /health still
# answers and you can see the service is up but unconfigured.
EnvironmentFile=-/etc/oncotrace/env
# Bind to loopback only -- nginx is the only thing that should reach this
# port. Never expose 8000 directly to the internet.
ExecStart=/home/anand/OncoTrace-AI/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

# Hard backstop on an 8 GB box: if the app-level semaphore above is ever
# bypassed by a bug, the kernel kills THIS service instead of letting memory
# pressure take down nginx, sshd, or anything else on the host. 6G leaves
# headroom for nginx + the OS above the ~8GB analysis budget calculated above;
# lower this if other services share the instance.
MemoryMax=6G
MemoryHigh=5G

# Basic sandboxing -- cheap to add, meaningfully reduces blast radius if the
# analysis pipeline (which shells out to bcftools/SnpEff on attacker-supplied
# files) is ever exploited.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/anand/OncoTrace-AI/server

[Install]
WantedBy=multi-user.target
