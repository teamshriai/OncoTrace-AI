# Optional overrides. All paths default to ./resources/<subdir> (see app/core/config.py).

# Human-readable panel name shown in the dashboard header.
ONCOTRACE_PANEL_NAME=Targeted Oncology Panel (GeneMind SURFSeq5000)

# Browser origins allowed to call this API.
ONCOTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload cap in bytes. Must match what the frontend advertises (500 MB).
ONCOTRACE_MAX_UPLOAD_BYTES=524288000

# Override reference-resource locations if they live outside ./resources.
# ONCOTRACE_RESOURCES=/data/oncotrace-refs
# ONCOTRACE_SNPEFF_JAR=/opt/snpeff/snpEff.jar
# ONCOTRACE_CLINVAR_GRCH38=/data/clinvar/clinvar_GRCh38.vcf.gz
# ONCOTRACE_REF_GRCH38=/data/reference/GRCh38.fa
# ONCOTRACE_PANEL_BED=/data/panel/panel.bed
