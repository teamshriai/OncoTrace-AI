# Overrides applied only for `npm run build` (Vite's production mode).
# Vite merges this on top of .env, so unrelated keys (EmailJS, etc.) still
# come from there -- only the keys below are production-specific.

# Empty base URL means the frontend calls a relative /api/... path, which the
# production nginx config reverse-proxies to the backend on the same origin.
# Never hardcode a domain here -- it would break as soon as the domain,
# environment, or port changes.
VITE_LB_API_BASE_URL=

# Always analyze the real uploaded file in production.
VITE_LB_USE_MOCK_API=false
